{
  "host": "127.0.0.1",
  "port": 8899,
  "connect_timeout": 1.5,
  "first_byte_timeout": 90.0,
  "read_timeout": 360.0,
  "write_timeout": 120.0,
  "probe_interval": 45.0,
  "probe_timeout": 4.0,
  "breaker_threshold": 2,
  "breaker_cooldown": 30.0,
  "_comment": "模板：复制为 config.json 后按你的环境修改。成员与昵称也可在 ECHO 面板「模型路由」页里改（写回本文件并热重载）。密钥不写在这里：按成员的 credential 名去 ~/.dsh/.credentials.yaml 取。",
  "groups": {
    "echo-auto": {
      "display_name": "ECHO AUTO",
      "require_token": true,
      "failover_on_status": [
        401,
        402,
        403,
        404,
        429
      ],
      "failover_on_5xx": true,
      "_comment_caps": "对 DSH 声明的最小能力：context_window / max_tokens 取各成员的较小值，避免把超长请求发给弱成员。",
      "context_window": 131072,
      "max_tokens": 32768,
      "members": [
        {
          "name": "内网大EP",
          "priority": 1,
          "enabled": true,
          "base_url": "https://your-intranet-gateway.example.com/v1",
          "model": "your-internal-model",
          "credential": "INTERNAL_LLM_TOKEN",
          "headers": {
            "userId": "your-user-id"
          },
          "body_mode": "passthrough",
          "context_window": 262144,
          "max_tokens": 32768
        },
        {
          "name": "内网Flash",
          "priority": 2,
          "enabled": true,
          "base_url": "https://your-intranet-gateway.example.com/v1",
          "model": "your-internal-model",
          "credential": "INTERNAL_LLM_TOKEN",
          "headers": {
            "userId": "your-user-id"
          },
          "body_mode": "passthrough",
          "context_window": 131072,
          "max_tokens": 32768
        },
        {
          "name": "外网官方",
          "priority": 3,
          "enabled": true,
          "base_url": "https://api.deepseek.com",
          "model": "deepseek-chat",
          "credential": "DEEPSEEK_API_KEY",
          "headers": {},
          "body_mode": "openai-safe",
          "context_window": 1000000,
          "max_tokens": 256000
        }
      ]
    }
  }
}
